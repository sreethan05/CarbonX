# CarbonX Backend Environment Variables
# Copy this file to .env and fill in your values

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# JWT Authentication
JWT_SECRET_KEY=your-secret-key-change-this-in-production

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Twilio (OTP SMS)
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE=your-twilio-phone

# Google Earth Engine
GEE_PROJECT=your-gee-project-id
GEE_KEY_PATH=path/to/gee-service-account.json

# Email (optional, for notifications)
EMAIL_ADDRESS=your-email@gmail.com
EMAIL_APP_PASSWORD=your-gmail-app-password

# Sarvam voice assistant
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_CHAT_MODEL=sarvam-105b-conversations
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_DEFAULT_LANGUAGE=te-IN
VOICE_MAX_AUDIO_SECONDS=30
VOICE_SESSION_TTL_SECONDS=900
VOICE_RATE_LIMIT_PER_MINUTE=10
